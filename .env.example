# O servidor lê variáveis do processo. Para carregar este arquivo:
# node --env-file=.env server/index.js
PORT=3000
HOST=0.0.0.0
DATA_DIR=./data
APP_ORIGIN=http://localhost:3000
NODE_ENV=development
# Ativar SOMENTE atrás de proxy confiável que reescreva X-Forwarded-For.
TRUST_PROXY=0

# Somente para a função Netlify. Gere localmente com npm run admin:netlify.
# Configure estes valores como variáveis protegidas no painel; não use este
# arquivo como destino dos valores reais e não envie credenciais ao GitHub.
ADMIN_EMAIL=
ADMIN_PASSWORD_SALT=
ADMIN_PASSWORD_HASH=
